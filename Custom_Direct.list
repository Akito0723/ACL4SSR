# NAME: Custom_Direct
# 强制直连域名列表，来自个人收集
# 部分域名可能和中国大陆域名列表存在重叠
# 规则内容较少，不会影响性能，请放心使用

# 暴雪战网国服相关
DOMAIN-SUFFIX,netease.com
DOMAIN-SUFFIX,leihuo.netease.com

# PT / BT 下载相关
DOMAIN-KEYWORD,tracker

# nvidia
DOMAIN-SUFFIX,events.gfe.nvidia.com

# Windows 网络连接探测
DOMAIN-SUFFIX,msftconnecttest.com
DOMAIN-SUFFIX,msftncsi.com

# ip
DOMAIN-SUFFIX,ipv4.icanhazip.com
DOMAIN-SUFFIX,ipinfo.io
DOMAIN-SUFFIX,myexternalip.com
DOMAIN-SUFFIX,test-ipv6.com
DOMAIN-SUFFIX,ipw.cn

# docker镜像
DOMAIN-SUFFIX,docker.1panel.live

# 内容：Steam判断所属区域的服务器列表
# 数量：16条
